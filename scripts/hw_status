#!/usr/bin/env bash
# Description: Dynamically detect hardware names for slstatus

case $1 in
    wifi_essid)
        # SSID of the active WiFi connection (via NetworkManager)
        ESSID=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '/^yes/{print $2; exit}')
        [ -n "$ESSID" ] && echo "$ESSID" || echo "off"
        ;;
    wifi_perc)
        # Signal strength (%) of the active WiFi connection (via NetworkManager)
        PERC=$(nmcli -t -f active,signal dev wifi 2>/dev/null | awk -F: '/^yes/{print $2; exit}')
        [ -n "$PERC" ] && echo "$PERC" || echo "0"
        ;;
    battery)
        # Find the first available battery (BAT0 or BAT1)
        BAT=$(ls /sys/class/power_supply/ | grep BAT | head -n 1)
        [ -n "$BAT" ] && cat "/sys/class/power_supply/$BAT/capacity" || echo "0"
        ;;
    temp)
        # Find the first thermal zone temperature
        if [ -f /sys/class/thermal/thermal_zone0/temp ]; then
            echo $(( $(cat /sys/class/thermal/thermal_zone0/temp) / 1000 ))
        else
            echo "n/a"
        fi
        ;;
esac